# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Supabase (PostgreSQL Veritabanı):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# OTURUM VE SUNUCU AYARLARI
# ==========================================
# Production: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY ve HTTPS APP_URL gerekir.
# Anon anahtar, API anahtarı veya URL kodu kullanıcı oturumu yerine geçmez.
# Kurulum ve migration zinciri: docs/SESSION_SECURITY.md + docs/PERSISTENCE_SECURITY.md

# Mevcut kargo şifreleme anahtarı; HTTP erişim anahtarı olarak kabul edilmez.
# Mevcut şifreli veri varken değiştirmek ayrıca veri/anahtar geçişi gerektirir.
API_SECRET_KEY=

# APP_URL origin her zaman kabul edilir. Ek originler tam URL olarak verilir.
# Boş değer yalnız APP_URL; '*' erişim vermez.
CORS_ORIGIN=
NODE_ENV=development

# Tek seferlik yönetici oluşturma; komut: npm run admin:bootstrap
# Mevcut firma ID'si ve en az 12 karakterlik benzersiz parola kullanın.
TOMNAP_ADMIN_EMAIL=
TOMNAP_ADMIN_PASSWORD=
TOMNAP_ADMIN_TENANT_ID=
TOMNAP_ADMIN_NAME=

# Aktivasyon/davet linkleri sadece APP_URL üzerinden üretilir. Production HTTPS kullanmalıdır.
# Production kayıt akışı için Resend zorunludur; simüle e-posta başarı sayılmaz.
RESEND_API_KEY=
EMAIL_FROM="TOMNAP <onboarding@resend.dev>"

# Yerel veri dizini; identity.json tek süreç içindir. Testler ayrı geçici dizin kullanır.
# Bağımsız e-posta retry CLI yalnız Supabase ile çalışır.
# NODE_ENV=development sunucusu yalnız 127.0.0.1 üzerinde dinler.
DATA_DIR=
# Varsayılan: DATA_DIR/uploads; public/ dışında kalmalıdır.
UPLOADS_DIR=
