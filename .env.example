# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Supabase (PostgreSQL Veritabanı):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# OTURUM VE SUNUCU AYARLARI
# ==========================================
# Production: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY ve HTTPS APP_URL gerekir.
# Anon anahtar, API anahtarı veya URL kodu kullanıcı oturumu yerine geçmez.
# Kurulum ve migration zinciri: docs/SESSION_SECURITY.md + docs/PERSISTENCE_SECURITY.md

# Kargo kimlik bilgileri: her değer 32 rastgele bayt / 64 hex, anahtar ID'si sabit.
# Kurulum/rotasyon ve eski API_SECRET_KEY geçişi: docs/PHASE4_SECURITY.md
# Üretimde secret manager üzerinden verin. Boş/geçersiz anahtar şifrelemeyi durdurur.
CARGO_ENCRYPTION_KEYS=
CARGO_ENCRYPTION_ACTIVE_KEY_ID=
# Eski API_SECRET_KEY yalnız geçiş CLI'sına --legacy-secret-env ile açıkça verilebilir.
# HTTP veya yeni şifreleme için kullanılmaz.
API_SECRET_KEY=

# APP_URL origin her zaman kabul edilir. Ek originler tam URL olarak verilir.
# Boş değer yalnız APP_URL; '*' erişim vermez.
CORS_ORIGIN=
NODE_ENV=development

# Tek seferlik yönetici oluşturma; komut: npm run admin:bootstrap
# Mevcut firma ID'si ve en az 12 karakterlik benzersiz parola kullanın.
TOMNAP_ADMIN_EMAIL=
TOMNAP_ADMIN_PASSWORD=
TOMNAP_ADMIN_TENANT_ID=
TOMNAP_ADMIN_NAME=

# Aktivasyon/davet linkleri sadece APP_URL üzerinden üretilir. Production HTTPS kullanmalıdır.
# Production kayıt akışı için Resend zorunludur; simüle e-posta başarı sayılmaz.
RESEND_API_KEY=
EMAIL_FROM="TOMNAP <onboarding@resend.dev>"

# Yerel veri dizini; identity.json tek süreç içindir. Testler ayrı geçici dizin kullanır.
# Bağımsız e-posta retry CLI yalnız Supabase ile çalışır.
# NODE_ENV=development sunucusu yalnız 127.0.0.1 üzerinde dinler.
DATA_DIR=
# Varsayılan: DATA_DIR/uploads; public/ dışında kalmalıdır.
UPLOADS_DIR=

# v2 akışları: insan onaylı manifest AWB eşleştirmesi. Varsayılan KAPALI.
# FF_V2_FLOW=true sunucuda /api/kargo/manifesto-eslestirme/{oneriler,onayla} uç noktalarını açar.
# VITE_FF_V2_FLOW=true inceleme ekranını istemciye ekler (derleme zamanında okunur).
# Kapalıyken manifest yükleme yalnız ayrıştırır. AWB hiçbir durumda isimle otomatik yazılmaz.
FF_V2_FLOW=
VITE_FF_V2_FLOW=

# Özel görsel depolaması: local veya supabase. Kurulum/geçiş: docs/PHASE5_RELIABILITY.md
# Vercel için supabase gerekir; private bucket API ile ayrı hazırlanır.
UPLOAD_STORAGE_BACKEND=local
